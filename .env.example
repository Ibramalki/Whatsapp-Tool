# Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# For API routes (server-side only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WaSenderAPI
# Session-specific API Key: Dashboard → Sessions → your session → API Key
WASENDER_API_KEY=your-session-api-key

# Personal Access Token (for session management — optional for basic use)
# Dashboard → Settings → Personal Access Token
# WASENDER_PERSONAL_ACCESS_TOKEN=your-pat

# Webhook secret (optional — for verifying incoming webhooks)
# WASENDER_WEBHOOK_SECRET=your-webhook-secret

# Notion Integration (for automated scheduling)
# Token: notion.so/my-integrations → your integration → Internal Integration Token
NOTION_TOKEN=ntn_...
# Community Messages database ID (from the database URL)
NOTION_MESSAGES_DB_ID=fd73de947c344e098ec52a7af3ed0970
# Communities database ID
NOTION_COMMUNITIES_DB_ID=a8c435d143164a2db11ada7ea1b7d451

# Anthropic (Claude AI — for message generation)
ANTHROPIC_API_KEY=your-anthropic-api-key
